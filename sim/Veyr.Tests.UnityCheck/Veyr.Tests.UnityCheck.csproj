<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only check. Builds the edit-mode test sources the way Unity's test runner will:
    C# 9, .NET Standard 2.1, and NUnit 3.5 (com.unity.ext.nunit is an NUnit 3.5 fork).
    It catches a test that uses an NUnit or BCL API Unity does not have. The tests run in
    Veyr.Tests.Sim on .NET 8.
  -->
  <PropertyGroup>
    <AssemblyName>Veyr.Tests.UnityCheck</AssemblyName>
    <RootNamespace>Veyr.Tests.Sim</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701;NU1903;NU1902</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Packages\com.veyrmarch.sim\Tests\**\*.cs" />
    <ProjectReference Include="..\Veyr.Sim\Veyr.Sim.csproj" />
    <ProjectReference Include="..\Veyr.Content\Veyr.Content.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.5.0" />
  </ItemGroup>
</Project>
