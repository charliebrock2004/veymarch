<Project>
  <!--
    Unity 6 compiles with C# 9 against the .NET Standard 2.1 API surface.
    Libraries that Unity also compiles (Packages/com.veyrmarch.*) build here with
    the same limits so an incompatibility fails this build, not the editor.
    Files that use nullable annotations opt in with `#nullable enable`, as Unity requires.
  -->
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>
</Project>
