# Online play (Realms). Both values are public: they are baked into the browser build.
# Every realm action is authorised by the vm_* functions in server/schema.sql, not by these keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Without them the build still works: Play shows "not set up" and Single Player is unchanged.
# For local development use the local realm instead: `npm run realm` and open the game with ?realm=local
